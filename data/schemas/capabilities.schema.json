{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/capabilities.schema.json",
  "title": "Gameplay Architecture V2 Capability Layer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "category",
          "scope",
          "provenance_status"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "source_flag": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "resistance",
              "item_ignore",
              "sustain",
              "perception",
              "survival",
              "curse",
              "class_combat",
              "class_magic",
              "class_misc",
              "offensive_modifier"
            ],
            "description": "Capability behavior family. Resistance and item_ignore categories must bind to the resistance layer."
          },
          "scope": {
            "type": "string",
            "enum": ["native_identity", "bearer_passive", "item_self_passive"],
            "description": "Gameplay Architecture V2 explicit capability scopes."
          },
          "grant_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["race", "class", "ring", "amulet", "armor", "weapon", "artifact", "ego"]
            },
            "description": "All known source types that can grant this capability. Informational; used for validation and tooling."
          },
          "resistance_id": {
            "$ref": "common.schema.json#/$defs/Id",
            "description": "Cross-layer reference to resistances.json when this capability encodes resistance or item-ignore semantics."
          },
          "notes": { "type": "string" },
          "provenance_status": { "$ref": "common.schema.json#/$defs/ProvenanceStatus" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": { "enum": ["resistance", "item_ignore"] }
              },
              "required": ["category"]
            },
            "then": {
              "required": ["resistance_id"]
            }
          },
          {
            "if": {
              "properties": {
                "scope": { "const": "item_self_passive" }
              },
              "required": ["scope"]
            },
            "then": {
              "properties": {
                "category": { "const": "item_ignore" }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scope": { "const": "native_identity" }
              },
              "required": ["scope"]
            },
            "then": {
              "properties": {
                "category": {
                  "enum": ["class_combat", "class_magic", "class_misc"]
                }
              }
            }
          }
        ]
      }
    }
  }
}
