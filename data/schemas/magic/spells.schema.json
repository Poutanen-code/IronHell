{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/spells.schema.json",
  "title": "Gameplay Architecture V2 Spell Definition Layer",
  "description": "Spell and prayer definition catalog. Policy metadata is separate from reusable Actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "realm", "spells"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "realm": {
      "type": "string",
      "enum": ["magic", "prayer"]
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SpellDefinition"
      }
    }
  },
  "$defs": {
    "Realm": {
      "type": "string",
      "enum": ["magic", "prayer"]
    },
    "SpellPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "mana",
        "fail_rate",
        "experience_value",
        "book_id",
        "realm"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "mana": {
          "type": "integer",
          "minimum": 0
        },
        "fail_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "experience_value": {
          "type": "integer",
          "minimum": 0
        },
        "book_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "realm": {
          "$ref": "#/$defs/Realm"
        }
      }
    },
    "SpellDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "policy",
        "action_refs",
        "provenance_status"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "$ref": "#/$defs/SpellPolicy"
        },
        "action_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionReference"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        },
        "provenance_status": {
          "$ref": "common.schema.json#/$defs/ProvenanceStatus"
        }
      }
    },
    "ActionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id"],
      "properties": {
        "action_id": {
          "$ref": "actions.schema.json#/$defs/ActionId"
        },
        "parameters": {
          "type": "object",
          "description": "Future parameter payload for action invocation."
        }
      }
    }
  }
}
