{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/spell_books.schema.json",
  "title": "Gameplay Architecture V2 Spell Book Definition Layer",
  "description": "Spell book catalog. Books reference spells by stable ID and declare verified realm and generation quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "books"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SpellBookDefinition"
      }
    }
  },
  "$defs": {
    "Realm": {
      "type": "string",
      "enum": ["magic", "prayer"]
    },
    "SpellBookDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "realm",
        "generation_quality",
        "spell_ids",
        "provenance_status"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "realm": {
          "$ref": "#/$defs/Realm"
        },
        "generation_quality": {
          "type": "string",
          "enum": ["normal", "good"]
        },
        "spell_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          }
        },
        "notes": {
          "type": "string"
        },
        "provenance_status": {
          "$ref": "common.schema.json#/$defs/ProvenanceStatus"
        }
      }
    }
  }
}
