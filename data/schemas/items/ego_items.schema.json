{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/items/ego_items.schema.json",
  "title": "Ego Items",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "_meta", "ego_items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "_meta": { "type": "object" },
    "ego_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "legacy_source_serial", "name", "rating", "xtra", "max_to_hit", "max_to_dam",
          "max_to_ac", "pval", "depth", "rarity", "cost", "applicability",
          "slots", "item_categories"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "legacy_source_serial": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "rating": { "type": "integer" },
          "xtra": { "type": "integer" },
          "max_to_hit": { "type": "integer" },
          "max_to_dam": { "type": "integer" },
          "max_to_ac": { "type": "integer" },
          "pval": { "type": "integer" },
          "depth": { "type": "integer" },
          "rarity": { "type": "integer" },
          "cost": { "type": "integer" },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "weapon_families": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["sword", "dagger", "axe", "mace", "polearm", "staff", "sling", "bow", "crossbow", "shot", "arrow", "bolt", "shovel", "pick", "mattock"] }
              },
              "weapon_classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["blade", "hafted", "polearm_and_axe", "launcher", "ammunition", "digging_tool"] }
              },
              "weapon_handling": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["one_handed", "two_handed", "ranged", "ammo", "digging"] }
              },
              "armor_forms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["chest", "helmet", "crown", "gloves", "boots", "shield", "cloak"] }
              },
              "armor_materials": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["cloth", "leather", "mail", "plate"] }
              },
              "armor_body_families": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["soft", "hard", "dragon_scale"] }
              },
              "item_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "common_item.schema.json#/$defs/Id" }
              }
            }
          },
          "slots": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["mainHand", "offHand", "head", "chest", "back", "hands", "feet", "ranged", "ammo"] }
          },
          "item_categories": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["weapon", "armor", "ranged", "ammo"] }
          },
          "combat_modifiers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "affixes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "value_source"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "value_source": { "type": "string", "enum": ["pval", "plus_to_hit", "plus_to_dam", "plus_to_ac"] }
                  }
                }
              },
              "capability_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common_item.schema.json#/$defs/Id" } },
              "resistance_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common_item.schema.json#/$defs/Id" } },
              "activations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
              "curses": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["light_curse", "heavy_curse", "perma_curse"] } },
              "display_flags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["show_mods", "hide_type"] } }
            }
          },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "recharge"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "recharge": {
                "type": "object",
                "additionalProperties": false,
                "required": ["base", "dice"],
                "properties": {
                  "base": { "type": "integer", "minimum": 0 },
                  "dice": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}