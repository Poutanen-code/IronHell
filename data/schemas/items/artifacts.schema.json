{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/artifacts.schema.json",
  "title": "Artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "baseItemId", "id", "name", "pval", "depth", "rarity",
          "weight", "cost", "base_ac", "damage", "plus_to_hit",
          "plus_to_dam", "plus_to_ac", "flags", "combat_modifiers", "affixes", "description"
        ],
        "properties": {
          "baseItemId": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "pval": { "type": "integer" },
          "depth": { "type": "integer" },
          "rarity": { "type": "integer" },
          "weight": { "type": "integer" },
          "cost": { "type": "integer" },
          "base_ac": { "type": "integer" },
          "damage": { "type": "string" },
          "plus_to_hit": { "type": "integer" },
          "plus_to_dam": { "type": "integer" },
          "plus_to_ac": { "type": "integer" },
          "flags": { "type": "array", "items": { "type": "string" } },
          "combat_modifiers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "affixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "value_source"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "value_source": { "type": "string", "minLength": 1 }
              }
            }
          },
          "activation": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "recharge"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "recharge": {
                "type": "object",
                "required": ["base", "dice"],
                "properties": {
                  "base": { "type": "integer", "minimum": 0 },
                  "dice": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "recharge_base": { "type": "integer", "minimum": 0 },
          "recharge_dice": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        },
        "if": {
          "properties": {
            "flags": { "contains": { "const": "ACTIVATE" } }
          }
        },
        "then": {
          "required": ["activation"]
        }
      }
    }
  }
}