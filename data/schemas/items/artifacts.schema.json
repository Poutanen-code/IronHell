{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/artifacts.schema.json",
  "title": "Artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "baseItemId", "id", "name", "pval", "depth", "rarity",
          "weight", "cost", "base_ac", "damage", "plus_to_hit",
          "plus_to_dam", "plus_to_ac", "flags", "effects", "description"
        ],
        "not": { "required": ["affixes"] },
        "properties": {
          "baseItemId": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "insta_art": { "type": "boolean" }
            }
          },
          "name": { "type": "string" },
          "pval": { "type": "integer" },
          "depth": { "type": "integer" },
          "rarity": { "type": "integer" },
          "weight": { "type": "integer" },
          "cost": { "type": "integer" },
          "base_ac": { "type": "integer" },
          "damage": { "type": "string" },
          "plus_to_hit": { "type": "integer" },
          "plus_to_dam": { "type": "integer" },
          "plus_to_ac": { "type": "integer" },
          "flags": { "type": "array", "items": { "type": "string" } },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "required": ["affixes", "combat_modifiers", "capabilities", "resistances", "activations", "curses", "display_flags"],
            "properties": {
              "affixes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "value_source"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "value_source": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "combat_modifiers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "resistances": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "activations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "curses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "display_flags": {
                "type": "array",
                "items": { "type": "string", "enum": ["show_mods", "hide_type"] },
                "uniqueItems": true
              }
            }
          },
          "activation": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "recharge"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "recharge": {
                "type": "object",
                "required": ["base", "dice"],
                "properties": {
                  "base": { "type": "integer", "minimum": 0 },
                  "dice": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "recharge_base": { "type": "integer", "minimum": 0 },
          "recharge_dice": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        },
        "if": {
          "properties": {
            "flags": { "contains": { "const": "ACTIVATE" } }
          }
        },
        "then": {
          "required": ["activation"]
        }
      }
    }
  }
}