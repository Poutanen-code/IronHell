{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/items/chests.schema.json",
  "title": "Chests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chests"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "chests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ChestItem" }
    }
  },
  "$defs": {
    "ChestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "tval", "sval", "weight", "sell_value",
        "trap_chance", "lock_difficulty", "gold_multiplier",
        "allocation_table", "trap_ids", "loot_actions", "state_policy",
        "description", "provenance_status"
      ],
      "properties": {
        "id": { "$ref": "common_item.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1 },
        "tval": { "$ref": "common_item.schema.json#/$defs/Tval" },
        "sval": { "$ref": "common_item.schema.json#/$defs/Sval" },
        "weight": { "type": "integer", "minimum": 0 },
        "sell_value": { "type": "integer", "minimum": 0 },
        "trap_chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "lock_difficulty": { "type": "integer", "minimum": 0 },
        "gold_multiplier": { "type": "integer", "minimum": 1 },
        "allocation_table": { "$ref": "common_item.schema.json#/$defs/AllocationTable" },
        "trap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common_item.schema.json#/$defs/Id" }
        },
        "loot_actions": { "$ref": "common_item.schema.json#/$defs/Actions" },
        "state_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_locked", "initial_trapped", "opens_once", "empties_on_open"],
          "properties": {
            "initial_locked": { "type": "boolean" },
            "initial_trapped": { "type": "boolean" },
            "opens_once": { "type": "boolean", "const": true },
            "empties_on_open": { "type": "boolean", "const": true }
          }
        },
        "description": { "type": "string", "minLength": 1 },
        "provenance_status": { "$ref": "common_item.schema.json#/$defs/ProvenanceStatus" }
      }
    }
  }
}
