{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/vaults.schema.json",
  "title": "Vaults",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vaults"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "vaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rating",
          "tags",
          "dimensions",
          "layout",
          "legend",
          "provenance_status"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "name": { "type": "string", "minLength": 1 },
          "rating": { "type": "integer", "minimum": 0 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rows", "cols"],
            "properties": {
              "rows": { "type": "integer", "minimum": 1 },
              "cols": { "type": "integer", "minimum": 1 }
            }
          },
          "layout": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "legend": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
              "^.$": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref", "provenance_status"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["terrain", "monster_spawn", "item_spawn", "trap_spawn", "special_marker"]
                  },
                  "ref": { "$ref": "common.schema.json#/$defs/Id" },
                  "provenance_status": { "$ref": "common.schema.json#/$defs/ProvenanceStatus" }
                }
              }
            }
          },
          "provenance_status": { "$ref": "common.schema.json#/$defs/ProvenanceStatus" }
        }
      }
    }
  }
}
