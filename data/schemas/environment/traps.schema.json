{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/traps.schema.json",
  "title": "Traps",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "traps"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "traps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "allowed_sources",
          "trap_category",
          "description",
          "effect_type",
          "visibility_model",
          "effect_tags",
          "provenance_status"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "name": { "type": "string", "minLength": 1 },
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["floor", "chest"]
            }
          },
          "trap_category": {
            "type": "string",
            "enum": [
              "pit",
              "dart",
              "gas",
              "rune",
              "elemental_spot",
              "transition",
              "concealed_generic"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "effect_type": {
            "type": "string",
            "enum": ["damage", "status", "stat_drain", "summon", "teleport", "level_transition", "mixed"]
          },
          "visibility_model": {
            "type": "string",
            "enum": ["hidden_until_detected", "visible", "disguised"]
          },
          "effect_tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "action_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "parameters"],
              "properties": {
                "action_id": { "type": "string", "minLength": 1 },
                "parameters": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "parity_notes": { "type": "string", "minLength": 1 },
          "provenance_status": { "$ref": "common.schema.json#/$defs/ProvenanceStatus" }
        }
      }
    }
  }
}
