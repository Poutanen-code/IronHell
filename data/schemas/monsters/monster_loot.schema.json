{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/monsters/monster_loot.schema.json",
  "title": "IronHell Monster Loot Profiles",
  "description": "Reusable monster loot profiles preserving MAngband 1.5.3 death-drop semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "_meta", "loot_profiles"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "description", "schema_path", "notes"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "schema_path": { "type": "string", "const": "data/schemas/monsters/monster_loot.schema.json" },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "loot_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/LootProfile" }
    }
  },
  "$defs": {
    "LootProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "drop_kind", "quantity", "bonus_drop_rules", "generation_rules", "special_rewards"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "minLength": 1
        },
        "drop_kind": { "type": "string", "enum": ["mixed", "items_only", "gold_only"] },
        "quantity": { "$ref": "#/$defs/Quantity" },
        "bonus_drop_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/BonusDropRule" }
        },
        "generation_rules": {
          "type": "array",
          "items": { "type": "string", "enum": ["good", "great"] }
        },
        "special_rewards": {
          "type": "array",
          "items": { "type": "string", "enum": ["morgoth_victory"] }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "legacy_richness_hint": { "type": "string", "enum": ["useful"] },
            "notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "sides"],
      "properties": {
        "kind": { "const": "dice" },
        "count": { "type": "integer", "minimum": 0 },
        "sides": { "type": "integer", "minimum": 1 }
      }
    },
    "BonusDropRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chance", "drops"],
      "properties": {
        "chance": { "type": "integer", "minimum": 1, "maximum": 100 },
        "drops": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
