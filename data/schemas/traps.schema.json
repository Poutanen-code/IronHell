{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/traps.schema.json",
  "title": "Traps",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "traps"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "traps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_feature_id",
          "trap_category",
          "trigger_behavior",
          "detection_behavior",
          "disarm_behavior",
          "effect_type",
          "visibility_model",
          "effect_tags",
          "provenance_status"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "name": { "type": "string", "minLength": 1 },
          "source_feature_id": { "$ref": "common.schema.json#/$defs/Id" },
          "trap_category": {
            "type": "string",
            "enum": [
              "pit",
              "dart",
              "gas",
              "rune",
              "elemental_spot",
              "transition",
              "concealed_generic"
            ]
          },
          "trigger_behavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger_type", "description"],
            "properties": {
              "trigger_type": {
                "type": "string",
                "enum": ["on_enter", "on_interact", "on_open", "on_disarm_failure", "mixed"]
              },
              "description": { "type": "string", "minLength": 1 }
            }
          },
          "detection_behavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["detection_model", "passive_search_applies", "active_detection_applies"],
            "properties": {
              "detection_model": {
                "type": "string",
                "enum": ["search_skill", "active_detection", "proximity", "none"]
              },
              "passive_search_applies": { "type": "boolean" },
              "active_detection_applies": { "type": "boolean" }
            }
          },
          "disarm_behavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disarm_model", "skill"],
            "properties": {
              "disarm_model": {
                "type": "string",
                "enum": ["not_disarmable", "skill_check", "special_case"]
              },
              "skill": {
                "anyOf": [
                  { "type": "null" },
                  { "$ref": "common.schema.json#/$defs/Id" }
                ]
              }
            }
          },
          "effect_type": {
            "type": "string",
            "enum": ["damage", "status", "stat_drain", "summon", "teleport", "level_transition", "mixed"]
          },
          "visibility_model": {
            "type": "string",
            "enum": ["hidden_until_detected", "visible", "disguised"]
          },
          "effect_tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "provenance_status": { "$ref": "common.schema.json#/$defs/ProvenanceStatus" }
        }
      }
    }
  }
}
