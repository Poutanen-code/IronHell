{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/flavors.schema.json",
  "title": "Flavors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "flavors"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "flavors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "display_name", "glyph", "color", "legacy", "provenance_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "category": {
            "type": "string",
            "enum": ["ring", "amulet", "staff", "wand", "rod", "potion", "mushroom", "scroll"]
          },
          "display_name": { "type": "string", "minLength": 1 },
          "glyph": { "type": "string", "minLength": 1, "maxLength": 1 },
          "color": { "type": "string", "minLength": 1, "maxLength": 1 },
          "legacy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mangband_index", "tval"],
            "properties": {
              "mangband_index": { "type": "integer" },
              "tval": { "type": "integer" },
              "sval": { "type": ["integer", "null"] }
            }
          },
          "provenance_status": { "type": "string" }
        }
      }
    }
  }
}