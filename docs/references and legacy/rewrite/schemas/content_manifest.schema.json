{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/content_manifest",
  "type": "object",
  "required": ["version", "dataPackId", "generatedAt", "files"],
  "properties": {
    "version": { "type": "string" },
    "dataPackId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "schemaPath", "version", "checksum"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "schemaPath": { "type": "string" },
          "version": { "type": "string" },
          "checksum": { "type": "string" }
        }
      }
    }
  }
}