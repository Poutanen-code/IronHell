{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/terrain_features",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "features"],
  "properties": {
    "version": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "index", "name", "symbol", "color", "blocksLos", "walkable"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "integer" },
          "name": { "type": "string" },
          "symbol": { "type": "string" },
          "color": { "type": "string" },
          "blocksLos": { "type": "boolean" },
          "walkable": { "type": "boolean" },
          "trapType": { "type": "string" },
          "shopType": { "type": "string" },
          "appearsAsFeatureId": { "type": "string" }
        }
      }
    }
  }
}