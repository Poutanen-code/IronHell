{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/vault_templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "version": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "roomType", "rating", "rows", "cols", "layout", "tags"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "integer" },
          "name": { "type": "string" },
          "roomType": { "type": "integer" },
          "rating": { "type": "integer" },
          "rows": { "type": "integer" },
          "cols": { "type": "integer" },
          "layout": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}