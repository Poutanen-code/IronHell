{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/wilderness_terrain_rules",
  "type": "object",
  "required": ["version", "world", "terrainTypes"],
  "properties": {
    "version": { "type": "string" },
    "world": {
      "type": "object",
      "required": ["width", "height", "centerX", "centerY"]
    },
    "terrainTypes": { "type": "array" }
  }
}