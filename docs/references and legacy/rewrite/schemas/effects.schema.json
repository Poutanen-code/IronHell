{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/effects",
  "title": "Effect Framework Definitions",
  "description": "Defines the Effect schema used by items, activations, spells, and monster abilities, plus the named effects catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "effects"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "effects": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/NamedEffect" }
    }
  },
  "$defs": {
    "EffectId": {
      "type": "string",
      "enum": [
        "damage",
        "heal",
        "apply_status",
        "cure_status",
        "restore_life",
        "restore_stat",
        "restore_all_stats",
        "drain_stat",
        "gain_stat",
        "restore_mana",
        "gain_experience",
        "drain_experience",
        "slow_poison",
        "satisfy_hunger",
        "teleport",
        "teleport_other",
        "teleport_level",
        "phase_door",
        "word_of_recall",
        "identify",
        "recharge",
        "detect",
        "mapping",
        "light_area",
        "dark_area",
        "summon",
        "probe",
        "haste",
        "berserk",
        "protection_from_evil",
        "banish",
        "dispel",
        "aggravate",
        "create_traps",
        "stone_to_mud",
        "destroy_traps_doors",
        "destroy_area",
        "enchant_item",
        "remove_curse",
        "curse_item",
        "create_object",
        "glyph_of_warding",
        "thrown_damage",
        "polymorph_monster",
        "heal_monster",
        "earthquake",
        "bizarre"
      ]
    },
    "DamageType": {
      "type": "string",
      "enum": [
        "physical",
        "fire",
        "cold",
        "acid",
        "lightning",
        "poison",
        "light",
        "dark",
        "sound",
        "shard",
        "nexus",
        "nether",
        "chaos",
        "disenchantment",
        "arcane",
        "mana",
        "holy"
      ]
    },
    "DamageShape": {
      "type": "string",
      "enum": ["bolt", "ball", "beam", "ray", "cone", "burst", "self"]
    },
    "StatName": {
      "type": "string",
      "enum": ["strength", "intelligence", "wisdom", "dexterity", "constitution", "charisma"]
    },
    "DetectTarget": {
      "type": "string",
      "enum": ["monsters", "objects", "traps", "doors", "stairs", "evil", "all"]
    },
    "BanishTarget": {
      "type": "string",
      "enum": ["evil", "non_unique", "all"]
    },
    "SummonType": {
      "type": "string",
      "enum": ["monster", "animal", "undead", "demon", "dragon", "spider", "hound", "unique"]
    },
    "ApplyStatusTarget": {
      "type": "string",
      "enum": ["self", "target", "all_nearby", "all_in_los"]
    },
    "DiceRoll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "sides": { "type": "integer", "minimum": 1 }
      }
    },
    "Duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "dice": { "$ref": "#/$defs/DiceRoll" }
      }
    },
    "DamageSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dice": { "$ref": "#/$defs/DiceRoll" },
        "flat_bonus": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["dice"] },
        { "required": ["flat_bonus"] }
      ]
    },
    "DamageEffect": {
      "type": "object",
      "required": ["effect_id", "damage_type", "shape"],
      "properties": {
        "effect_id": { "type": "string", "const": "damage" },
        "damage_type": { "$ref": "#/$defs/DamageType" },
        "shape": { "$ref": "#/$defs/DamageShape" },
        "dice": { "$ref": "#/$defs/DiceRoll" },
        "flat_bonus": { "type": "integer", "minimum": 0 },
        "radius": { "type": "integer", "minimum": 0, "default": 0 },
        "count": {
          "description": "Number of projectiles fired. Used for multi-bolt effects like STAR_BALL.",
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "is_drain": {
          "description": "When true, damage dealt to a target heals the caster by the same amount.",
          "type": "boolean"
        }
      }
    },
    "HealEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "heal" },
        "dice": { "$ref": "#/$defs/DiceRoll" },
        "flat_bonus": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["dice"] },
        { "required": ["flat_bonus"] }
      ]
    },
    "ApplyStatusEffect": {
      "type": "object",
      "required": ["effect_id", "status_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "apply_status" },
        "status_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "duration": { "$ref": "#/$defs/Duration" },
        "target": { "$ref": "#/$defs/ApplyStatusTarget" }
      }
    },
    "CureStatusEffect": {
      "type": "object",
      "required": ["effect_id", "status_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "cure_status" },
        "status_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "RestoreLifeEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "restore_life" }
      }
    },
    "RestoreStatEffect": {
      "type": "object",
      "required": ["effect_id", "stat"],
      "properties": {
        "effect_id": { "type": "string", "const": "restore_stat" },
        "stat": { "$ref": "#/$defs/StatName" }
      }
    },
    "RestoreAllStatsEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "restore_all_stats" }
      }
    },
    "TeleportEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "teleport" },
        "distance": {
          "description": "Maximum teleport distance in tiles. 0 means level-wide.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "TeleportOtherEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "teleport_other" },
        "distance": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "PhaseDoorEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "phase_door" },
        "distance": {
          "description": "Maximum phase distance. Defaults to 10.",
          "type": "integer",
          "minimum": 1,
          "default": 10
        }
      }
    },
    "WordOfRecallEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "word_of_recall" }
      }
    },
    "IdentifyEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "identify" },
        "identify_all": {
          "description": "If true, identifies all items in the inventory at once.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "RechargeEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "recharge" },
        "power": {
          "description": "Recharge power level. Higher values can recharge stronger devices but risk explosions.",
          "type": "integer",
          "minimum": 1,
          "default": 60
        }
      }
    },
    "DetectEffect": {
      "type": "object",
      "required": ["effect_id", "targets"],
      "properties": {
        "effect_id": { "type": "string", "const": "detect" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/DetectTarget" }
        }
      }
    },
    "MappingEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "mapping" },
        "radius": {
          "description": "Mapping radius in tiles. 0 means the entire current level.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "LightAreaEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "light_area" },
        "radius": { "type": "integer", "minimum": 0, "default": 2 },
        "type": {
          "type": "string",
          "enum": ["torch", "starlight", "permanent"]
        },
        "damage_undead": {
          "description": "When true, the light also harms undead creatures.",
          "type": "boolean",
          "default": false
        },
        "ray_count": {
          "description": "Number of starlight rays to emit. Used for ILLUMINATION / STARLIGHT activations.",
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "SummonEffect": {
      "type": "object",
      "required": ["effect_id", "summon_type"],
      "properties": {
        "effect_id": { "type": "string", "const": "summon" },
        "summon_type": { "$ref": "#/$defs/SummonType" },
        "count": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "ProbeEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "probe" }
      }
    },
    "HasteEffect": {
      "type": "object",
      "required": ["effect_id", "duration"],
      "properties": {
        "effect_id": { "type": "string", "const": "haste" },
        "duration": { "$ref": "#/$defs/Duration" }
      }
    },
    "BerserkEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "berserk" },
        "duration": { "$ref": "#/$defs/Duration" }
      }
    },
    "ProtectionFromEvilEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "protection_from_evil" },
        "duration": { "$ref": "#/$defs/Duration" }
      }
    },
    "BanishEffect": {
      "type": "object",
      "required": ["effect_id", "target"],
      "properties": {
        "effect_id": { "type": "string", "const": "banish" },
        "target": { "$ref": "#/$defs/BanishTarget" }
      }
    },
    "StoneToMudEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "stone_to_mud" }
      }
    },
    "DestroyTrapsDoorEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "destroy_traps_doors" }
      }
    },
    "BizarreEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "bizarre" }
      }
    },
    "DrainStatEffect": {
      "type": "object",
      "required": ["effect_id", "stat"],
      "properties": {
        "effect_id": { "type": "string", "const": "drain_stat" },
        "stat": { "$ref": "#/$defs/StatName" }
      }
    },
    "GainStatEffect": {
      "type": "object",
      "required": ["effect_id", "stat"],
      "properties": {
        "effect_id": { "type": "string", "const": "gain_stat" },
        "stat": { "$ref": "#/$defs/StatName" }
      }
    },
    "RestoreManaEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "restore_mana" }
      }
    },
    "GainExperienceEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "gain_experience" },
        "flat_amount": {
          "description": "Grant this many XP, or half of (current XP + flat_amount), whichever is less.",
          "type": "integer",
          "minimum": 1
        },
        "percent_of_max": {
          "description": "Grant this percentage of max XP instead.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "DrainExperienceEffect": {
      "type": "object",
      "required": ["effect_id", "percent"],
      "properties": {
        "effect_id": { "type": "string", "const": "drain_experience" },
        "percent": {
          "description": "Fraction of current XP to drain (e.g. 0.25 = 25%).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "SlowPoisonEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "slow_poison" }
      }
    },
    "SatisfyHungerEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "satisfy_hunger" }
      }
    },
    "TeleportLevelEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "teleport_level" }
      }
    },
    "DarkAreaEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "dark_area" },
        "radius": { "type": "integer", "minimum": 0, "default": 3 }
      }
    },
    "AggravateEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "aggravate" },
        "radius": {
          "description": "0 = all monsters on the level.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "CreateTrapsEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "create_traps" },
        "radius": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },
    "DispelEffect": {
      "type": "object",
      "required": ["effect_id", "creature_type", "flat_bonus"],
      "properties": {
        "effect_id": { "type": "string", "const": "dispel" },
        "creature_type": {
          "type": "string",
          "enum": ["undead", "evil", "demon", "animal", "dragon"]
        },
        "flat_bonus": { "type": "integer", "minimum": 1 }
      }
    },
    "DestroyAreaEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "destroy_area" },
        "radius": { "type": "integer", "minimum": 1, "default": 15 }
      }
    },
    "EnchantItemEffect": {
      "type": "object",
      "required": ["effect_id", "target"],
      "properties": {
        "effect_id": { "type": "string", "const": "enchant_item" },
        "target": {
          "type": "string",
          "enum": ["weapon_to_hit", "weapon_to_dam", "weapon_both", "armor"]
        },
        "attempts": {
          "description": "Fixed number of enchantment attempts.",
          "type": "integer",
          "minimum": 1
        },
        "attempts_dice": {
          "description": "Random additional attempts on top of base.",
          "$ref": "#/$defs/DiceRoll"
        },
        "attempts_base": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "RemoveCurseEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "remove_curse" },
        "heavy": {
          "description": "When true, also removes heavy curses. Permanent curses are always unaffected.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "CurseItemEffect": {
      "type": "object",
      "required": ["effect_id", "target"],
      "properties": {
        "effect_id": { "type": "string", "const": "curse_item" },
        "target": {
          "type": "string",
          "enum": ["weapon", "armor"]
        }
      }
    },
    "CreateObjectEffect": {
      "type": "object",
      "required": ["effect_id", "quality"],
      "properties": {
        "effect_id": { "type": "string", "const": "create_object" },
        "quality": {
          "type": "string",
          "enum": ["good", "great"]
        },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "count_dice": { "$ref": "#/$defs/DiceRoll" }
      }
    },
    "GlyphOfWardingEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "glyph_of_warding" }
      }
    },
    "ThrownDamageEffect": {
      "type": "object",
      "required": ["effect_id", "damage_type", "dice"],
      "properties": {
        "effect_id": { "type": "string", "const": "thrown_damage" },
        "damage_type": { "$ref": "#/$defs/DamageType" },
        "dice": { "$ref": "#/$defs/DiceRoll" }
      }
    },
    "PolymorphMonsterEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "polymorph_monster" }
      }
    },
    "HealMonsterEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "heal_monster" },
        "flat_bonus": { "type": "integer", "minimum": 0 },
        "dice": { "$ref": "#/$defs/DiceRoll" }
      }
    },
    "EarthquakeEffect": {
      "type": "object",
      "required": ["effect_id"],
      "properties": {
        "effect_id": { "type": "string", "const": "earthquake" },
        "radius": { "type": "integer", "minimum": 1, "default": 8 }
      }
    },
    "Effect": {
      "description": "A single effect step. The effect_id field discriminates the variant.",
      "oneOf": [
        { "$ref": "#/$defs/DamageEffect" },
        { "$ref": "#/$defs/HealEffect" },
        { "$ref": "#/$defs/ApplyStatusEffect" },
        { "$ref": "#/$defs/CureStatusEffect" },
        { "$ref": "#/$defs/RestoreLifeEffect" },
        { "$ref": "#/$defs/RestoreStatEffect" },
        { "$ref": "#/$defs/RestoreAllStatsEffect" },
        { "$ref": "#/$defs/TeleportEffect" },
        { "$ref": "#/$defs/TeleportOtherEffect" },
        { "$ref": "#/$defs/PhaseDoorEffect" },
        { "$ref": "#/$defs/WordOfRecallEffect" },
        { "$ref": "#/$defs/IdentifyEffect" },
        { "$ref": "#/$defs/RechargeEffect" },
        { "$ref": "#/$defs/DetectEffect" },
        { "$ref": "#/$defs/MappingEffect" },
        { "$ref": "#/$defs/LightAreaEffect" },
        { "$ref": "#/$defs/SummonEffect" },
        { "$ref": "#/$defs/ProbeEffect" },
        { "$ref": "#/$defs/HasteEffect" },
        { "$ref": "#/$defs/BerserkEffect" },
        { "$ref": "#/$defs/ProtectionFromEvilEffect" },
        { "$ref": "#/$defs/BanishEffect" },
        { "$ref": "#/$defs/StoneToMudEffect" },
        { "$ref": "#/$defs/DestroyTrapsDoorEffect" },
        { "$ref": "#/$defs/BizarreEffect" },
        { "$ref": "#/$defs/DrainStatEffect" },
        { "$ref": "#/$defs/GainStatEffect" },
        { "$ref": "#/$defs/RestoreManaEffect" },
        { "$ref": "#/$defs/GainExperienceEffect" },
        { "$ref": "#/$defs/DrainExperienceEffect" },
        { "$ref": "#/$defs/SlowPoisonEffect" },
        { "$ref": "#/$defs/SatisfyHungerEffect" },
        { "$ref": "#/$defs/TeleportLevelEffect" },
        { "$ref": "#/$defs/DarkAreaEffect" },
        { "$ref": "#/$defs/AggravateEffect" },
        { "$ref": "#/$defs/CreateTrapsEffect" },
        { "$ref": "#/$defs/DispelEffect" },
        { "$ref": "#/$defs/DestroyAreaEffect" },
        { "$ref": "#/$defs/EnchantItemEffect" },
        { "$ref": "#/$defs/RemoveCurseEffect" },
        { "$ref": "#/$defs/CurseItemEffect" },
        { "$ref": "#/$defs/CreateObjectEffect" },
        { "$ref": "#/$defs/GlyphOfWardingEffect" },
        { "$ref": "#/$defs/ThrownDamageEffect" },
        { "$ref": "#/$defs/PolymorphMonsterEffect" },
        { "$ref": "#/$defs/HealMonsterEffect" },
        { "$ref": "#/$defs/EarthquakeEffect" }
      ]
    },
    "NamedEffect": {
      "description": "A named, reusable effect instance from the catalog. Used as reference building blocks for consumables, rods, wands, staves, and spells.",
      "allOf": [
        { "$ref": "#/$defs/Effect" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "description": "Unique snake_case identifier for this named effect instance.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      ]
    }
  }
}
