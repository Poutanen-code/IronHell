{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/spell_books",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "realms"],
  "properties": {
    "version": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "idFormat", "linkKey", "pairedWith", "notes"],
      "properties": {
        "contract": { "type": "string" },
        "idFormat": { "type": "string" },
        "linkKey": { "type": "string", "const": "spellId" },
        "pairedWith": { "type": "string", "const": "spell_metadata.json" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "realms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classes", "books"],
        "properties": {
          "id": { "type": "string" },
          "classes": { "type": "array", "items": { "type": "string" } },
          "books": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "bookIndex", "spells"],
              "properties": {
                "id": { "type": "string" },
                "bookIndex": { "type": "integer" },
                "spells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["spellId", "spellIndex", "spellName"],
                    "properties": {
                      "spellId": {
                        "type": "string",
                        "pattern": "^(mage|priest)-[0-9]+$"
                      },
                      "spellIndex": { "type": "integer" },
                      "spellName": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}