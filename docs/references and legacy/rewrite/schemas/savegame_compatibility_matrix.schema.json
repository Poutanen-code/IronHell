{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/savegame_compatibility_matrix",
  "type": "object",
  "required": ["version", "currentSaveVersion", "compatibility"],
  "properties": {
    "version": { "type": "string" },
    "currentSaveVersion": { "type": "string" },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromVersion", "toVersion", "strategy"],
        "properties": {
          "fromVersion": { "type": "string" },
          "toVersion": { "type": "string" },
          "strategy": { "type": "string" },
          "migrationScript": { "type": "string" }
        }
      }
    }
  }
}