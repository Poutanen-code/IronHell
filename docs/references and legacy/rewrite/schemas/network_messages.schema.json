{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/network_messages",
  "type": "object",
  "required": ["version", "messages"],
  "properties": {
    "version": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "direction", "reliable", "schemaRef", "deprecated"],
        "properties": {
          "id": { "type": "string" },
          "direction": { "type": "string" },
          "reliable": { "type": "boolean" },
          "schemaRef": { "type": "string" },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  }
}