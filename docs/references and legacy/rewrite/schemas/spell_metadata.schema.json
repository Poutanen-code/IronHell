{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ironhell/rewrite/spell_metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "spells"],
  "properties": {
    "version": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "idFormat", "linkKey", "pairedWith", "sources", "notes"],
      "properties": {
        "contract": { "type": "string" },
        "idFormat": { "type": "string" },
        "linkKey": { "type": "string", "const": "spellId" },
        "pairedWith": { "type": "string", "const": "spell_books.json" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mangbandCompendia", "ironhellCode"],
          "properties": {
            "mangbandCompendia": { "type": "array", "items": { "type": "string" } },
            "ironhellCode": { "type": "array", "items": { "type": "string" } }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spellId", "realm", "spellIndex", "name", "bookIndex", "targeting", "casting", "effects"],
        "properties": {
          "spellId": {
            "type": "string",
            "pattern": "^(mage|priest)-[0-9]+$"
          },
          "realm": {
            "type": "string",
            "enum": ["mage", "priest"]
          },
          "spellIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
          "name": { "type": "string" },
          "bookIndex": { "type": ["integer", "null"], "minimum": 0 },
          "targeting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "requiresLineOfSight",
              "canTargetSelf",
              "canTargetAlly",
              "canTargetEnemy"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["directional", "self", "area", "item", "none", "unknown"]
              },
              "requiresLineOfSight": { "type": "boolean" },
              "canTargetSelf": { "type": "boolean" },
              "canTargetAlly": { "type": "boolean" },
              "canTargetEnemy": { "type": "boolean" }
            }
          },
          "casting": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slevel", "smana", "sfail"],
            "properties": {
              "slevel": { "type": "integer" },
              "smana": { "type": "integer" },
              "sfail": { "type": "integer" }
            }
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["effectType", "summary"],
              "properties": {
                "effectType": {
                  "type": "string",
                  "enum": ["damage", "heal", "detect", "teleport", "buff", "status", "item", "world", "utility", "none"]
                },
                "summary": { "type": "string" },
                "damageModel": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["effectKey", "damageType", "shape", "radius", "baseDamage", "scalingStat", "scalingRatio", "beamMode"],
                  "properties": {
                    "effectKey": { "type": "string" },
                    "damageType": { "type": "string" },
                    "shape": { "type": "string", "enum": ["bolt", "beam", "ball", "multi_impact"] },
                    "radius": { "type": "integer", "minimum": 0 },
                    "baseDamage": { "type": "integer", "minimum": 0 },
                    "scalingStat": { "type": "string", "enum": ["intelligence", "wisdom"] },
                    "scalingRatio": { "type": "number", "minimum": 0 },
                    "beamMode": { "type": "string", "enum": ["none", "reduced", "full", "low", "always"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}