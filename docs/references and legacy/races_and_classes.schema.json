{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironhell.local/schemas/races_and_classes.schema.json",
  "title": "Races And Classes",
  "type": "object",
  "additionalProperties": false,
  "required": ["races", "classes", "race_class_combos"],
  "properties": {
    "races": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id", "name", "description", "stat_modifiers", "skill_modifiers", "hit_die",
          "exp_factor", "infravision", "racial_flags", "allowed_class_ids", "racial_abilities",
          "size", "vision_type", "lore"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "stat_modifiers": { "type": "object" },
          "skill_modifiers": { "type": "object" },
          "hit_die": { "type": "integer" },
          "exp_factor": { "type": "integer" },
          "infravision": { "type": "integer" },
          "racial_flags": { "type": "array", "items": { "type": "string" } },
          "allowed_class_ids": { "type": "array", "items": { "type": "string" } },
          "racial_abilities": { "type": "array", "items": { "type": "object" } },
          "size": { "type": "string" },
          "vision_type": { "type": "string" },
          "lore": { "type": "string" }
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id", "name", "description", "primary_role", "primary_stats", "secondary_stats",
          "stat_modifiers", "base_skills", "skill_growth", "hit_die", "exp_factor", "sense_base",
          "sense_div", "max_attacks", "min_weight", "attack_multiplier", "first_spell_level",
          "class_flags", "titles", "hp_per_level", "mana_per_level", "equipment_proficiency",
          "starting_equipment", "lore"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "primary_role": { "type": "string" },
          "primary_stats": { "type": "array", "items": { "type": "string" } },
          "secondary_stats": { "type": "array", "items": { "type": "string" } },
          "stat_modifiers": { "type": "object" },
          "base_skills": { "type": "object" },
          "skill_growth": { "type": "object" },
          "hit_die": { "type": "integer" },
          "exp_factor": { "type": "integer" },
          "sense_base": { "type": "integer" },
          "sense_div": { "type": "integer" },
          "max_attacks": { "type": "integer" },
          "min_weight": { "type": "integer" },
          "attack_multiplier": { "type": "integer" },
          "spell_stat": { "type": ["string", "null"] },
          "first_spell_level": { "type": "integer" },
          "class_flags": { "type": "array", "items": { "type": "string" } },
          "titles": { "type": "array", "items": { "type": "string" } },
          "hp_per_level": { "type": "integer" },
          "mana_per_level": { "type": "integer" },
          "equipment_proficiency": { "type": "object" },
          "starting_equipment": { "type": "array", "items": { "type": "string" } },
          "lore": { "type": "string" }
        }
      }
    },
    "race_class_combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["race_id", "class_id", "lore"],
        "properties": {
          "race_id": { "type": "string" },
          "class_id": { "type": "string" },
          "lore": { "type": "string" }
        }
      }
    }
  }
}